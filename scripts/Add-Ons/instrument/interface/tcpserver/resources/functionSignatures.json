{
    "tcpserver": {
        "inputs": [
            {
                "name": "ServerAddress",
                "kind": "ordered",
                "type": [ "char", "string" ]
            },
            {
                "name": "ServerPort",
                "kind": "required",
                "type": [ "numeric", "integer", "<=65535", ">=1" ]
            },
            {
                "name": "ByteOrder",
                "kind": "namevalue",
                "type": "choices={'little-endian', 'big-endian'}"
            },
            {
                "name": "Timeout",
                "kind": "namevalue",
                "type": [ "numeric", ">=0" ]
            },
            {
                "name": "Tag",
                "kind": "namevalue",
                "type": [
                    [ "scalar", "string" ],
                    [ "char" ]
                ]
            },
            {
                "name": "ConnectionChangedFcn",
                "kind": "namevalue",
                "type": [ "function_handle", "scalar" ]
            }
        ],
        "outputs": [
            {
                "name": "obj",
                "type": "tcpserver.internal.TCPServer"
            }
        ]
    },
