FROM eclipse-temurin:17-jdk

WORKDIR /matlab

# Copy Maven Wrapper and pom.xml
COPY mvnw pom.xml ./
COPY .mvn .mvn

# Copy source files
COPY src ./src

# Fix Windows line endings (CRLF -> LF) and make executable
RUN tr -d '\r' < mvnw > mvnw.tmp && mv mvnw.tmp mvnw && chmod +x mvnw

# Copy the entrypoint script
COPY entrypoint.sh /matlab/entrypoint.sh
RUN tr -d '\r' < /matlab/entrypoint.sh > /matlab/entrypoint.sh.tmp && mv /matlab/entrypoint.sh.tmp /matlab/entrypoint.sh && chmod +x /matlab/entrypoint.sh

# Set the entrypoint
ENTRYPOINT ["./entrypoint.sh"]