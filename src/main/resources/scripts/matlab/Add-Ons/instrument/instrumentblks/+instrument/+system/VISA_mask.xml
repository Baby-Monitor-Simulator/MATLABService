  <Display IconOpaque="transparent" RunInitForIconRedraw="off">blockUsage = get_param(gcb, &quot;BlockMode&quot;);

if bdIsLibrary(bdroot(gcb))
    icon = &apos;VISA&apos;;
else
    if strcmpi(blockUsage , &quot;Send command&quot;)
        icon = &apos;VISA \nSend&apos;;
    elseif strcmpi(blockUsage , &quot;Query Instrument&quot;)
        icon = &apos;VISA \nQuery&apos;;
    else
        icon = &apos;VISA \nReceive&apos;;
    end
end

% Set the icon name.
disp(icon);

if (strcmpi(blockUsage, &apos;Send command&apos;) || strcmpi(blockUsage, &apos;Query Instrument&apos;) ) &amp;&amp; ...
        (strcmpi(get_param(gcb, &quot;SendCommandType&quot;), &apos;Compose command from input data&apos;) || ...
        strcmpi(get_param(gcb, &quot;SendCommandType&quot;), &apos;Send input port data as is&apos;))

    port_label(&apos;input&apos;, 1, &apos;Input&apos;);

end

if strcmpi(blockUsage , &quot;Send command&quot;)
    if strcmpi(get_param(gcb, &quot;ActionWhenerror&quot;), &apos;Stop Simulation&apos;)
        return;
    end
    if strcmpi(get_param(gcb, &quot;Checkerror&quot;), &quot;on&quot;)
        port_label(&apos;output&apos;, 1,  &apos;Instrument error&apos;);
    end
else
    if strcmpi(get_param(gcb, &quot;ActionWhenerror&quot;), &apos;Stop Simulation&apos;)
        port_label(&apos;output&apos;, 1, &apos;Output&apos;);
        return;
    end
    if strcmpi(get_param(gcb, &quot;Checkerror&quot;), &quot;on&quot;)
        port_label(&apos;output&apos;, 1, &apos;Output&apos;);
        port_label(&apos;output&apos;, 2, &apos;Status&apos;);
        port_label(&apos;output&apos;, 3,  &apos;Instrument error&apos;);
    else
        port_label(&apos;output&apos;, 1, &apos;Output&apos;);
        port_label(&apos;output&apos;, 2, &apos;Status&apos;);
    end
end

</Display>
