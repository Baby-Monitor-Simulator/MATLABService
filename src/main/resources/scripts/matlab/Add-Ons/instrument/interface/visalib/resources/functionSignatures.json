{
    "visadevlist":
    {
        "inputs":
        [
            {
                "name":"Timeout",
                "kind":"namevalue",
                "type":["numeric", "scalar", ">=2"]
            }
        ],
        "outputs":
        [
            {
                "name":"devlist",
                "type":"table"
            }
        ]
    },
    "visadev":
    {
        "inputs": [
            {
                "name": "resourceID",
                "kind": "required",
                "type": "choices=visalib.internal.TabCompletionHelper.resourceIDOptions"
            },
            {
                "name": "Tag",
                "kind": "namevalue",
                "type": [
                    [ "scalar", "string" ],
                    [ "char" ]
                ]
            }
        ],
        "outputs":
        [
            {
                "name":"resource",
                "type":"visalib.Resource"
            }
        ]
    },
    "visalib.Resource.read":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"count",
                "kind":"required",
                "type":[ "numeric", "integer", "positive", "scalar" ]
            },
            {
                "name":"precision",
                "kind":"positional",
                "type": "choices= matlabshared.transportlib.internal.client.GenericClient.PrecisionOptions"
            }
        ],
        "outputs":
        [
            {
                "name":"data",
                "type":[ ["double"], ["char"], ["string"] ]
            }
        ]
    },
    "visalib.Resource.readline":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            }
        ],
        "outputs":
        [
            {
                "name":"data",
                "type":"string"
            }
        ]
    },
    "visalib.Resource.readbinblock":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"precision",
                "kind":"positional",
                "type": "choices= matlabshared.transportlib.internal.client.GenericClient.PrecisionOptions"
            }
        ],
        "outputs":
        [
            {
                "name":"data",
                "type":[ ["double"], ["char"], ["string"] ]
            }
        ]
    },
    "visalib.Resource.write":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"data",
                "kind":"required",
                "type":[ ["numeric"], ["char"], ["string"] ]
            },
            {
                "name":"precision",
                "kind":"positional",
                "type": "choices= matlabshared.transportlib.internal.client.GenericClient.PrecisionOptions"
            }
        ]
    },
    "visalib.Resource.writeline":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"data",
                "kind":"required",
                "type":[ ["char"], ["string"] ]
            }
        ]
    },
    "visalib.Resource.writebinblock":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"data",
                "kind":"required",
                "type":[ ["numeric"], ["char"], ["string"] ]
            },
            {
                "name":"precision",
                "kind":"required",
                "type": "choices= matlabshared.transportlib.internal.client.GenericClient.PrecisionOptions"
            }
        ]
    },
    "visalib.Resource.writeread":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"command",
                "kind":"required",
                "type":"choices=visalib.internal.TabCompletionHelper.queryOptions"
            }
        ]
    },
    "visalib.Resource.flush":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"buffer",
                "kind":"ordered",
                "type":"choices={'input', 'output'}"
            }
        ]
    },
    "visalib.Resource.configureCallback":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name": "mode",
                "kind": "required",
                "type": "choices={'off', 'byte', 'terminator'}"
            },
            {
                "name": "count",
                "kind": "positional",
                "type": [ "numeric", "integer", "scalar", ">0" ]
            },
            {
                "name": "callbackfcn",
                "kind": "positional",
                "type": [ "function_handle", "scalar" ]
            }
        ]
    },
    "visalib.Resource.configureTerminator":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name": "terminator",
                "kind": "required",
                "type":
                [
                    [ "numeric", "integer", "scalar", ">=0", "<=255" ],
                    [ "choices={'off', 'LF', 'CR', 'CR/LF'}" ]
                ]
            },
            {
                "name": "writeTerminator",
                "kind": "optional",
                "type":
                [
                    [ "numeric", "integer", "scalar", ">=0", "<=255" ],
                    [ "choices={'LF', 'CR', 'CR/LF'}" ]
                ]
            }
        ]
    },
    "visalib.Resource.visastatus":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            }
        ],
        "outputs":
        [
            {
                "name":"ready",
                "type":"logical"
            },
            {
                "name":"status",
                "type":"double"
            }
        ]
    },
    "visalib.Resource.setTransferPeriod":
    {
        "inputs":
        [
            {
                "name":"resource",
                "kind":"required",
                "type":"visalib.Resource"
            },
            {
                "name":"period",
                "kind":"required",
                "type":
                [
                    [ "numeric", "integer", "scalar", ">=0", "<=4294967295" ]
                ]
            }
        ]
    },
