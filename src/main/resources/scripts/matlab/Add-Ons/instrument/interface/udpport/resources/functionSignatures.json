{
    "udpport": {
        "inputs": [
            {
                "name": "Type",
                "kind": "ordered",
                "type": "choices = {'byte', 'datagram'}"
            },
            {
                "name": "IPAddressVersion",
                "kind": "ordered",
                "type": "choices = {'IPV4', 'IPV6'}"
            },
            {
                "name": "ByteOrder",
                "kind": "namevalue",
                "type": "choices={'little-endian', 'big-endian'}"
            },
            {
                "name": "Timeout",
                "kind": "namevalue",
                "type": "double"
            },
            {
                "name": "Tag",
                "kind": "namevalue",
                "type": [
                    [ "scalar", "string" ],
                    [ "char" ]
                ]
            },
            {
                "name": "LocalHost",
                "kind": "namevalue",
                "type": [ "scalar", "string", "char" ]
            },
            {
                "name": "LocalPort",
                "kind": "namevalue",
                "type": [ "scalar", "integer", ">=0", "<=65535" ]
            },
            {
                "name": "OutputDatagramSize",
                "kind": "namevalue",
                "type": [ "scalar", "integer", "positive" ]
            },
            {
                "name": "EnablePortSharing",
                "kind": "namevalue",
                "type": [ "scalar", "logical" ]
            }

        ],
        "outputs": [
            {
                "name": "obj",
                "type": [
                    [ "udpport.byte.UDPPort" ],
                    [ "udpport.datagram.UDPPort" ]
                ]
            }
        ]
    },
